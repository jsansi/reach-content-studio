{
  "name": "reach-content-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "npm run build && node server/index.ts",
    "serve": "node server/index.ts",
    "dev": "node scripts/dev.js",
    "build": "npm run build:ds && vite build",
    "typecheck": "tsc -p .",
    "test": "node --test tests/*.test.ts",
    "task:check": "node scripts/task-check.ts",
    "task:preview": "node scripts/task-preview.ts",
    "tasks:list": "node scripts/tasks-list.ts",
    "render": "node studio/render.js",
    "build:ds": "node design-system/btl/build.mjs",
    "check:ds": "node design-system/btl/scripts/check.mjs"
  },
  "devDependencies": {
    "@fontsource/noto-sans": "^5.1.0",
    "@types/node": "^24.19.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "playwright": "^1.47.2",
    "typescript": "^5.9.3",
    "vite": "^6.4.4"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.134.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/sora": "^5.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=24"
  }
}
